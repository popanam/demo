#!/bin/bash

# Настройка hostname
hostnamectl set-hostname br-fw.au-team.irpo;

cat  > /etc/sysconfig/network << EOF
NETWORKING=yes
CONFMETHOD=etcnet
HOSTNAME=br-fw.au-team.irpo
DOMAINNAME=localdomain
RESOLV_MODS=yes
EOF


# Настройка маршутизации
sed -i "s/net.ipv4.ip_forward = 0/net.ipv4.ip_forward = 1/" "/etc/net/sysctl.conf"


#Chrony
sed -i 's/pool pool.ntp.org iburst/pool 172.16.1.1 iburst/g' /etc/chrony.conf
systemctl restart chronyd

#Создание enp7s1
mkdir -p /etc/net/ifaces/enp7s2
cp -r /etc/net/ifaces/enp7s1/options /etc/net/ifaces/enp7s2/options
echo "192.168.0.1/30" > /etc/net/ifaces/enp7s2/ipv4address

#Время
apt-get update
apt-get install tzdata
find /usr/share/zoneinfo -name Krasnoyarsk
timedatectl set-timezone Asia/Krasnoyarsk
timedatectl


# Установка FRR (если не установлен)
apt-get install -y frr

# Включение OSPF в /etc/frr/daemons (меняем ospfd=no на ospfd=yes)
sed -i 's/ospfd=no/ospfd=yes/' /etc/frr/daemons

# Перезагрузка демона и запуск FRR
systemctl daemon-reload
systemctl enable --now frr

# Настройка OSPF через vtysh (автоматический ввод команд) МЕНЯЙТЕ НА СВОИ АДРЕСА
cat <<EOF > /etc/frr/frr.conf
router ospf

network 192.168.1.0/30 area 0
network 192.168.0.0/28 area 0
exit

do wr
exit

EOF

systemctl restart network
systemctl restart  frr



# Файл /resolv.conf
cat > /etc/net/ifaces/enp7s1/resolv.conf << EOF
nameserver 192.168.100.2
search au-team.irpo
EOF
exec bash
