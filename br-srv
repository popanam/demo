#!/bin/bash
hostnamectl set-hostname br-srv.au-team.irpo;
apt-get install sshpass

cat  > /etc/sysconfig/network <<EOF
NETWORKING=yes
CONFMETHOD=etcnet
HOSTNAME=br-srv.au-team.irpo
DOMAINNAME=localdomain
RESOLV_MODS=yes
EOF


#Время
apt-get update
apt-get install tzdata
find /usr/share/zoneinfo -name Krasnoyarsk
timedatectl set-timezone Asia/Krasnoyarsk
timedatectl


#Chrony

sed -i 's/pool pool.ntp.org iburst/pool 172.16.1.1 iburst/g' /etc/chrony.conf
systemctl restart chronyd


systemctl enable --now chronyd
        systemctl restart chronyd
echo "Настройка SSH"

# Создание пользователя sshuser с UID 2027 (МЕНЯЙТЕ ИМЯ И Т.Д В ЗАВИСИМОСТИ ОТ ЗАДАНИЯ)
useradd -u 2027 -m sshuser

# Установка пароля P@ssw0rd без подтверждения
echo "sshuser:P@ssw0rd" | chpasswd

# Добавление в группу wheel
gpasswd -a sshuser wheel

# Настройка sudo без пароля
echo "sshuser ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers





# Настройка SSH
sed -i 's/#Port 22/Port 2027/' /etc/openssh/sshd_config
sed -i 's/#PermitRootLogin without-password/PermitRootLogin no/' /etc/openssh/sshd_config
sed -i 's/#PermitRootLogin without-password/PermitRootLogin no/' /etc/openssh/sshd_config
echo "AllowUsers sshuser" >> /etc/openssh/sshd_config
echo "MaxAuthTries 2" >> /etc/openssh/sshd_config
echo "Banner /etc/openssh/banner" >> /etc/openssh/sshd_config

# Создание баннера
echo "Authorized access only" > /etc/openssh/banner

# Перезапуск SSH
systemctl restart sshd

echo "Настройка завершена:"
echo "- Пользователь: sshuser (пароль: P@ssw0rd)"
echo "- SSH порт: 2027"
echo "- Root-логин запрещен"
echo "- Баннер создан"


echo "- Скачиваем файл инвентаря"
apt-get update && apt-get install -y ansible sshpass 
cd /etc/ansible
wget raw.githubusercontent.com/popanam/demo/refs/heads/main/inventory.yml

wget raw.githubusercontent.com/popanam/demo/refs/heads/main/get.yml

cd ~

cat > /etc/ansible/ansible.cfg << EOF
[defaults]

interpreter_python = /usr/bin/python3
inventory = /etc/ansible/inventory.yml
host_key_cheking = false


[inventory]
[privilege_escalation]
[paramiko_connection]
[ssh_connection]
[persistent_connection]
[accelerate]
[selinux]
[colors]
[diff]
EOF




# Файл /etc/net/ifaces/enp7s1/resolv.conf
cat > /etc/net/ifaces/enp7s1/resolv.conf << EOF
nameserver 77.88.8.8
nameserver 192.168.100.2
search au-team.irpo
EOF


wget raw.githubusercontent.com/popanam/demo/refs/heads/main/docker
chmod +x docker
wget raw.githubusercontent.com/popanam/demo/refs/heads/main/samba
chmod +x samba
wget raw.githubusercontent.com/popanam/demo/refs/heads/main/user
chmod +x user
wget raw.githubusercontent.com/popanam/demo/refs/heads/main/ssh
chmod +x ssh

exec bash
