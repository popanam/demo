#!/bin/bash

# ==============================================================================
# КОМПЛЕКСНЫЙ СКРИПТ ПРОВЕРКИ ДЕМОНСТРАЦИОННОГО ЭКЗАМЕНА
# Специальность: 09.02.06 Сетевое и системное администрирование
# КОД: 09.02.06-1-2026
# Версия: 2.0
# Описание: Автоматизированная проверка всех модулей демоэкзамена
# ==============================================================================

# --- Цвета ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# --- Счетчики ---
PASS=0
FAIL=0
WARN=0

# --- Функции ---
header() {
    echo ""
    echo -e "${BLUE}══════════════════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}  $1${NC}"
    echo -e "${BLUE}══════════════════════════════════════════════════════════════${NC}"
}

subheader() {
    echo ""
    echo -e "${CYAN}  ── $1 ──${NC}"
}

ok() {
    echo -e "  [${GREEN}✓${NC}] $1"
    ((PASS++))
}

fail() {
    echo -e "  [${RED}✗${NC}] $1"
    ((FAIL++))
}

warn() {
    echo -e "  [${YELLOW}!${NC}] $1"
    ((WARN++))
}

info() {
    echo -e "  [${CYAN}i${NC}] $1"
}

# ==============================================================================
# БЛОК 0: ОБЩАЯ ИНФОРМАЦИЯ О СИСТЕМЕ
# ==============================================================================
header "БЛОК 0: ОБЩАЯ ИНФОРМАЦИЯ О СИСТЕМЕ"

echo "  Хостнейм: $(hostname)"
echo "  Ядро: $(uname -r)"
echo "  Дистрибутив: $(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d'"' -f2)"
echo "  Uptime: $(uptime -p 2>/dev/null || uptime)"
echo "  IP-адреса:"
ip -br addr show 2>/dev/null | while read line; do
    echo "    $line"
done

# ==============================================================================
# МОДУЛЬ 1: НАСТРОЙКА СЕТЕВОЙ ИНФРАСТРУКТУРЫ
# ==============================================================================
header "МОДУЛЬ 1: НАСТРОЙКА СЕТЕВОЙ ИНФРАСТРУКТУРЫ"

# --- 1.1 Базовая настройка устройств ---
subheader "1.1 Базовая настройка устройств"

# Проверка hostname
if [ -n "$(hostname)" ] && [ "$(hostname)" != "localhost" ]; then
    ok "Hostname настроен: $(hostname)"
else
    fail "Hostname не настроен или равен localhost"
fi

# Проверка часового пояса
TZ=$(timedatectl show --property=Timezone --value 2>/dev/null)
if [ -n "$TZ" ]; then
    ok "Часовой пояс: $TZ"
else
    fail "Часовой пояс не настроен"
fi

# Проверка синхронизации времени
if timedatectl show --property=NTPSynchronized --value 2>/dev/null | grep -q "yes"; then
    ok "Время синхронизировано"
else
    warn "Время НЕ синхронизировано"
fi

# --- 1.2 Настройка ISP ---
subheader "1.2 Настройка ISP"

# Проверка наличия внешнего IP (шлюза)
DEFAULT_GW=$(ip route | grep default | awk '{print $3}' | head -1)
if [ -n "$DEFAULT_GW" ]; then
    ok "Шлюз по умолчанию: $DEFAULT_GW"
    if ping -c 2 -W 2 "$DEFAULT_GW" &>/dev/null; then
        ok "Шлюз доступен (ping)"
    else
        fail "Шлюз НЕ доступен (ping)"
    fi
else
    fail "Шлюз по умолчанию не настроен"
fi

# Проверка выхода в интернет
if ping -c 2 -W 3 8.8.8.8 &>/dev/null; then
    ok "Выход в интернет работает (8.8.8.8)"
else
    fail "Нет выхода в интернет"
fi

# Проверка DNS-разрешения
if nslookup ya.ru &>/dev/null; then
    ok "DNS-разрешение работает (ya.ru)"
else
    fail "DNS-разрешение НЕ работает"
fi

# --- 1.3 Создание локальных учетных записей ---
subheader "1.3 Создание локальных учетных записей"

USERS_TO_CHECK=("sshuser" "admin" "user1" "user2")
for u in "${USERS_TO_CHECK[@]}"; do
    if id "$u" &>/dev/null; then
        ok "Пользователь '$u' существует"
    else
        warn "Пользователь '$u' не найден"
    fi
done

# --- 1.4 Настройка коммутации ---
subheader "1.4 Настройка коммутации"

if command -v brctl &>/dev/null; then
    if brctl show 2>/dev/null | grep -q "bridge"; then
        ok "Мосты (bridges) настроены"
        brctl show 2>/dev/null | head -5
    else
        warn "Мосты не обнаружены"
    fi
elif command -v ip &>/dev/null; then
    if ip link show type bridge 2>/dev/null | grep -q "bridge"; then
        ok "Мосты настроены (через ip link)"
    else
        warn "Мосты не обнаружены"
    fi
fi

# --- 1.5 Настройка безопасного удаленного доступа (SSH) ---
subheader "1.5 Настройка безопасного удаленного доступа (SSH)"

if systemctl is-active --quiet sshd; then
    ok "Служба sshd запущена"
else
    fail "Служба sshd НЕ запущена"
fi

if [ -f /etc/ssh/sshd_config ]; then
    ok "Файл /etc/ssh/sshd_config существует"
    # Проверка запрета root-логина
    if grep -q "^PermitRootLogin no" /etc/ssh/sshd_config 2>/dev/null; then
        ok "Вход root по SSH запрещён"
    else
        warn "Вход root по SSH разрешён или не настроен"
    fi
    # Проверка порта
    SSH_PORT=$(grep -E "^Port " /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}')
    if [ -n "$SSH_PORT" ]; then
        ok "SSH слушает порт: $SSH_PORT"
    else
        info "SSH использует порт по умолчанию (22)"
    fi
else
    fail "Файл /etc/ssh/sshd_config не найден"
fi

# --- 1.6 Настройка IP-туннеля (GRE/IPIP) ---
subheader "1.6 Настройка IP-туннеля"

if ip tunnel show 2>/dev/null | grep -q "gre\|ipip"; then
    ok "IP-туннели обнаружены:"
    ip tunnel show 2>/dev/null | head -5
else
    warn "IP-туннели не обнаружены"
fi

# --- 1.7 Настройка динамической маршрутизации ---
subheader "1.7 Настройка динамической маршрутизации"

# Проверка OSPF / RIP / BGP
if command -v vtysh &>/dev/null; then
    ok "FRRouting (vtysh) установлен"
    if systemctl is-active --quiet frr; then
        ok "Служба FRR запущена"
    else
        fail "Служба FRR НЕ запущена"
    fi
else
    # Проверка через zebra/quagga
    for daemon in zebra ospfd ripd bgpd; do
        if systemctl is-active --quiet "$daemon" 2>/dev/null; then
            ok "Демон $daemon запущен"
        fi
    done
fi

# Проверка таблицы маршрутизации
ROUTE_COUNT=$(ip route show | wc -l)
if [ "$ROUTE_COUNT" -gt 3 ]; then
    ok "Таблица маршрутизации содержит $ROUTE_COUNT записей"
else
    warn "Таблица маршрутизации содержит всего $ROUTE_COUNT записей"
fi

# --- 1.8 Настройка динамической трансляции адресов (NAT) ---
subheader "1.8 Настройка NAT"

if command -v iptables &>/dev/null; then
    if iptables -t nat -L -n 2>/dev/null | grep -q "MASQUERADE\|SNAT"; then
        ok "Правила NAT обнаружены (iptables)"
    else
        warn "Правила NAT не обнаружены (iptables)"
    fi
elif command -v nft &>/dev/null; then
    if nft list ruleset 2>/dev/null | grep -q "masquerade\|snat"; then
        ok "Правила NAT обнаружены (nftables)"
    else
        warn "Правила NAT не обнаружены (nftables)"
    fi
fi

# --- 1.9 Настройка протокола динамической конфигурации хостов (DHCP) ---
subheader "1.9 Настройка DHCP"

if systemctl is-active --quiet dhcpd 2>/dev/null || systemctl is-active --quiet isc-dhcp-server 2>/dev/null; then
    ok "Служба DHCP запущена"
else
    warn "Служба DHCP НЕ запущена (возможно, не требуется на этой ВМ)"
fi

if [ -f /etc/dhcp/dhcpd.conf ]; then
    ok "Файл /etc/dhcp/dhcpd.conf существует"
    SUBNET_COUNT=$(grep -c "^subnet" /etc/dhcp/dhcpd.conf 2>/dev/null)
    if [ "$SUBNET_COUNT" -gt 0 ]; then
        ok "Настроено подсетей: $SUBNET_COUNT"
    else
        warn "Подсети не найдены в конфигурации DHCP"
    fi
else
    info "Файл /etc/dhcp/dhcpd.conf не найден"
fi

# --- 1.10 Настройка инфраструктуры разрешения доменных имен (DNS) ---
subheader "1.10 Настройка DNS"

if systemctl is-active --quiet named 2>/dev/null || systemctl is-active --quiet bind9 2>/dev/null; then
    ok "Служба DNS (named/bind9) запущена"
else
    warn "Служба DNS НЕ запущена"
fi

if [ -f /etc/bind/named.conf ] || [ -f /etc/named.conf ]; then
    ok "Конфигурация DNS существует"
    ZONE_COUNT=$(grep -c "^zone" /etc/bind/named.conf 2>/dev/null || grep -c "^zone" /etc/named.conf 2>/dev/null)
    if [ "$ZONE_COUNT" -gt 0 ]; then
        ok "Настроено зон: $ZONE_COUNT"
    fi
else
    info "Файл конфигурации DNS не найден"
fi

# Проверка разрешения имён
for domain in "hq.sirius" "br.sirius"; do
    if nslookup "$domain" &>/dev/null; then
        ok "DNS-разрешение для '$domain' работает"
    else
        warn "DNS-разрешение для '$domain' не работает"
    fi
done

# --- 1.11 Настройка часового пояса ---
subheader "1.11 Настройка часового пояса"

if [ -n "$TZ" ]; then
    ok "Часовой пояс: $TZ"
else
    fail "Часовой пояс не настроен"
fi

# ==============================================================================
# МОДУЛЬ 2: ОРГАНИЗАЦИЯ СЕТЕВОГО АДМИНИСТРИРОВАНИЯ
# ==============================================================================
header "МОДУЛЬ 2: ОРГАНИЗАЦИЯ СЕТЕВОГО АДМИНИСТРИРОВАНИЯ"

# --- 2.1 Настройка контроллера домена Samba DC ---
subheader "2.1 Настройка контроллера домена Samba DC"

if systemctl is-active --quiet samba 2>/dev/null || systemctl is-active --quiet smbd 2>/dev/null; then
    ok "Служба Samba запущена"
else
    fail "Служба Samba НЕ запущена"
fi

if [ -f /etc/samba/smb.conf ]; then
    ok "Файл /etc/samba/smb.conf существует"

    # Проверка работы как DC
    if grep -q "server role = active directory domain controller" /etc/samba/smb.conf 2>/dev/null; then
        ok "Samba настроена как Active Directory DC"
    else
        info "Samba не настроена как AD DC (возможно, standalone)"
    fi

    # Проверка realm
    REALM=$(grep "^realm" /etc/samba/smb.conf 2>/dev/null | head -1 | awk '{print $3}')
    if [ -n "$REALM" ]; then
        ok "Realm: $REALM"
    fi

    # Проверка workgroup
    WORKGROUP=$(testparm -s 2>/dev/null | grep "workgroup" | awk '{print $3}')
    if [ -n "$WORKGROUP" ]; then
        ok "Workgroup: $WORKGROUP"
    fi

    # Проверка DNS forwarder
    if grep -q "dns forwarder" /etc/samba/smb.conf 2>/dev/null; then
        ok "DNS forwarder настроен"
    fi

    # Проверка samba-tool
    if command -v samba-tool &>/dev/null; then
        ok "samba-tool доступен"
        DOMAIN_INFO=$(samba-tool domain info 127.0.0.1 2>/dev/null)
        if [ -n "$DOMAIN_INFO" ]; then
            ok "Домен доступен через samba-tool"
        fi
    fi
else
    fail "Файл /etc/samba/smb.conf не найден"
fi

# --- 2.2 Настройка файлового хранилища ---
subheader "2.2 Настройка файлового хранилища"

# Проверка смонтированных ФС
if mount | grep -qE "nfs|cifs|/srv|/mnt"; then
    ok "Сетевые файловые системы смонтированы:"
    mount | grep -E "nfs|cifs|/srv|/mnt" | head -5
else
    info "Сетевые файловые системы не обнаружены"
fi

# Проверка NFS
if systemctl is-active --quiet nfs-server 2>/dev/null || systemctl is-active --quiet nfs-kernel-server 2>/dev/null; then
    ok "Служба NFS запущена"
    if [ -f /etc/exports ]; then
        ok "Файл /etc/exports существует"
        EXPORT_COUNT=$(grep -vc "^#" /etc/exports 2>/dev/null)
        info "Экспортировано ресурсов: $EXPORT_COUNT"
    fi
fi

# --- 2.3 Настройка сервера сетевой файловой системы ---
subheader "2.3 Настройка сервера сетевой файловой системы"

if [ -f /etc/exports ]; then
    ok "Конфигурация NFS-экспорта существует"
else
    info "Файл /etc/exports не найден"
fi

# --- 2.4 Настройка служб сетевого времени (chrony) ---
subheader "2.4 Настройка служб сетевого времени (chrony)"

if command -v chronyc &>/dev/null; then
    ok "chrony установлен"

    if systemctl is-active --quiet chronyd; then
        ok "Служба chronyd запущена"
    else
        fail "Служба chronyd НЕ запущена"
    fi

    # Проверка источников
    SOURCES=$(chronyc sources 2>/dev/null | grep -c "^\^*\|^\+")
    if [ "$SOURCES" -gt 0 ]; then
        ok "Активных источников времени: $SOURCES"
    else
        warn "Нет активных источников времени"
    fi

    # Проверка синхронизации
    if chronyc tracking 2>/dev/null | grep -q "Leap status.*Normal"; then
        ok "Статус синхронизации: Normal"
    fi
else
    warn "chrony не установлен"
fi

# --- 2.5 Настройка ansible ---
subheader "2.5 Настройка Ansible"

if command -v ansible &>/dev/null; then
    ok "Ansible установлен"
    ANSIBLE_VER=$(ansible --version 2>/dev/null | head -1)
    info "Версия: $ANSIBLE_VER"

    if [ -f /etc/ansible/hosts ]; then
        ok "Инвентарь /etc/ansible/hosts существует"
        HOST_COUNT=$(grep -vc "^#\|^\[" /etc/ansible/hosts 2>/dev/null)
        info "Хостов в инвентаре: $HOST_COUNT"
    fi

    if [ -f /etc/ansible/ansible.cfg ]; then
        ok "Конфигурация /etc/ansible/ansible.cfg существует"
    fi
else
    warn "Ansible не установлен"
fi

# --- 2.6 Настройка веб-приложения с использованием средств контейнеризации (Docker) ---
subheader "2.6 Настройка Docker"

if command -v docker &>/dev/null; then
    ok "Docker установлен"

    if systemctl is-active --quiet docker; then
        ok "Служба Docker запущена"
    else
        fail "Служба Docker НЕ запущена"
    fi

    RUNNING=$(docker ps -q 2>/dev/null | wc -l)
    if [ "$RUNNING" -gt 0 ]; then
        ok "Запущено контейнеров: $RUNNING"
        docker ps --format "    - {{.Names}} ({{.Image}})" 2>/dev/null
    else
        warn "Запущенных контейнеров нет"
    fi

    # Проверка docker-compose
    if command -v docker-compose &>/dev/null || docker compose version &>/dev/null; then
        ok "docker-compose доступен"
    fi
else
    warn "Docker не установлен"
fi

# --- 2.7 Настройка веб-приложения на сервере ---
subheader "2.7 Настройка веб-приложения на сервере"

if systemctl is-active --quiet apache2 2>/dev/null || systemctl is-active --quiet httpd 2>/dev/null; then
    ok "Веб-сервер (Apache) запущен"
fi

if systemctl is-active --quiet nginx; then
    ok "Веб-сервер Nginx запущен"
fi

# --- 2.8 Настройка трансляции портов ---
subheader "2.8 Настройка трансляции портов"

if iptables -t nat -L -n 2>/dev/null | grep -q "DNAT"; then
    ok "Правила DNAT (трансляция портов) обнаружены"
    iptables -t nat -L -n 2>/dev/null | grep "DNAT" | head -3
else
    warn "Правила DNAT не обнаружены"
fi

# --- 2.9 Настройка обратного прокси-сервера (Nginx) ---
subheader "2.9 Настройка обратного прокси-сервера"

if command -v nginx &>/dev/null; then
    ok "Nginx установлен"

    if systemctl is-active --quiet nginx; then
        ok "Служба Nginx запущена"
    else
        fail "Служба Nginx НЕ запущена"
    fi

    if nginx -t 2>/dev/null; then
        ok "Конфигурация Nginx корректна"
    else
        fail "Ошибка в конфигурации Nginx"
    fi

    # Проверка настроек proxy_pass
    if grep -rq "proxy_pass" /etc/nginx/ 2>/dev/null; then
        ok "Настроен proxy_pass (обратный прокси)"
    else
        info "proxy_pass не найден в конфигурации"
    fi
else
    warn "Nginx не установлен"
fi

# --- 2.10 Настройка web-based аутентификации ---
subheader "2.10 Настройка web-based аутентификации"

if [ -f /etc/nginx/.htpasswd ] || [ -f /etc/apache2/.htpasswd ]; then
    ok "Файл паролей для web-аутентификации найден"
else
    info "Файл web-аутентификации не найден"
fi

# --- 2.11 Установка Яндекс Браузера ---
subheader "2.11 Установка Яндекс Браузера"

if command -v yandex-browser &>/dev/null || [ -f /opt/yandex/browser/yandex-browser ]; then
    ok "Яндекс Браузер установлен"
else
    info "Яндекс Браузер не установлен"
fi

# ==============================================================================
# МОДУЛЬ 3: ЭКСПЛУАТАЦИЯ ОБЪЕКТОВ СЕТЕВОЙ ИНФРАСТРУКТУРЫ
# ==============================================================================
header "МОДУЛЬ 3: ЭКСПЛУАТАЦИЯ ОБЪЕКТОВ СЕТЕВОЙ ИНФРАСТРУКТУРЫ"

# --- 3.1 Импорт пользователей в домен ---
subheader "3.1 Импорт пользователей в домен"

if command -v samba-tool &>/dev/null; then
    USER_COUNT=$(samba-tool user list 2>/dev/null | wc -l)
    if [ "$USER_COUNT" -gt 0 ]; then
        ok "Пользователей в домене: $USER_COUNT"
    else
        warn "Не удалось получить список пользователей домена"
    fi
fi

# --- 3.2 Настройка сертификатов ГОСТ ---
subheader "3.2 Настройка сертификатов ГОСТ"

if command -v openssl &>/dev/null; then
    if openssl list -engines 2>/dev/null | grep -qi "gost"; then
        ok "Поддержка ГОСТ в OpenSSL доступна"
    else
        info "Поддержка ГОСТ в OpenSSL не обнаружена"
    fi
fi

if [ -d /etc/pki/ca-trust ] || [ -d /usr/share/ca-certificates ]; then
    ok "Хранилище сертификатов существует"
fi

# --- 3.3 Настройка IPsec на EcoRouter ---
subheader "3.3 Настройка IPsec"

if command -v ipsec &>/dev/null; then
    ok "IPsec (strongSwan/LibreSwan) установлен"
    if systemctl is-active --quiet strongswan 2>/dev/null || systemctl is-active --quiet ipsec 2>/dev/null; then
        ok "Служба IPsec запущена"
    else
        warn "Служба IPsec НЕ запущена"
    fi
else
    info "IPsec не установлен (возможно, используется на маршрутизаторе)"
fi

# --- 3.4 Настройка межсетевого экрана ---
subheader "3.4 Настройка межсетевого экрана"

if command -v iptables &>/dev/null; then
    RULES=$(iptables -L -n 2>/dev/null | grep -c "^ACCEPT\|^DROP\|^REJECT")
    if [ "$RULES" -gt 0 ]; then
        ok "Активных правил iptables: $RULES"
    else
        warn "Правила iptables не обнаружены"
    fi
fi

if command -v firewall-cmd &>/dev/null; then
    ok "firewalld доступен"
    if systemctl is-active --quiet firewalld; then
        ok "Служба firewalld запущена"
    fi
fi

# --- 3.5 Настройка принт-сервера ---
subheader "3.5 Настройка принт-сервера"

if systemctl is-active --quiet cups 2>/dev/null; then
    ok "Служба CUPS (принт-сервер) запущена"
else
    info "CUPS не запущен (возможно, не требуется на этой ВМ)"
fi

# --- 3.6 Логирование, ротация логов ---
subheader "3.6 Логирование и ротация логов"

if systemctl is-active --quiet rsyslog 2>/dev/null; then
    ok "Служба rsyslog запущена"
else
    warn "Служба rsyslog НЕ запущена"
fi

if [ -f /etc/logrotate.conf ]; then
    ok "Конфигурация logrotate существует"
    LOGROTATE_CONFS=$(ls /etc/logrotate.d/ 2>/dev/null | wc -l)
    info "Дополнительных конфигураций: $LOGROTATE_CONFS"
else
    warn "Конфигурация logrotate не найдена"
fi

# --- 3.7 Мониторинг (Grafana + Prometheus) ---
subheader "3.7 Мониторинг (Grafana + Prometheus)"

if systemctl is-active --quiet grafana-server 2>/dev/null || systemctl is-active --quiet grafana 2>/dev/null; then
    ok "Grafana запущена"
else
    info "Grafana не запущена"
fi

if systemctl is-active --quiet prometheus 2>/dev/null; then
    ok "Prometheus запущен"
else
    info "Prometheus не запущен"
fi

# Проверка node_exporter
if systemctl is-active --quiet node_exporter 2>/dev/null; then
    ok "node_exporter запущен"
fi

# --- 3.8 Инвентаризация с помощью ansible плейбука ---
subheader "3.8 Инвентаризация (Ansible плейбук)"

PLAYBOOKS=$(find / -name "*.yml" -path "*ansible*" 2>/dev/null | head -5)
if [ -n "$PLAYBOOKS" ]; then
    ok "Ansible плейбуки найдены:"
    echo "$PLAYBOOKS" | while read p; do echo "    - $p"; done
else
    info "Ansible плейбуки не найдены"
fi

# --- 3.9 Защита SSH от атак методом перебора ---
subheader "3.9 Защита SSH от атак методом перебора"

if command -v fail2ban-client &>/dev/null; then
    ok "Fail2ban установлен"
    if systemctl is-active --quiet fail2ban; then
        ok "Служба fail2ban запущена"
        JAILS=$(fail2ban-client status 2>/dev/null | grep "Jail list" | cut -d: -f2)
        if [ -n "$JAILS" ]; then
            ok "Активные jail: $JAILS"
        fi
    else
        fail "Служба fail2ban НЕ запущена"
    fi
else
    warn "Fail2ban не установлен"
fi

# Проверка denyhosts
if command -v denyhosts &>/dev/null; then
    ok "DenyHosts установлен"
fi

# --- 3.10 Резервное копирование ---
subheader "3.10 Резервное копирование"

if command -v rsync &>/dev/null; then
    ok "rsync доступен"
fi

if command -v tar &>/dev/null; then
    ok "tar доступен"
fi

if command -v borg &>/dev/null; then
    ok "BorgBackup доступен"
fi

# Проверка crontab для бэкапов
if crontab -l 2>/dev/null | grep -qi "backup\|rsync\|tar\|borg"; then
    ok "Задания резервного копирования в crontab найдены"
else
    info "Задания резервного копирования в crontab не найдены"
fi

# Проверка systemd timer
if systemctl list-timers 2>/dev/null | grep -qi "backup"; then
    ok "Таймеры systemd для бэкапа найдены"
fi

# ==============================================================================
# ИТОГОВЫЙ ОТЧЕТ
# ==============================================================================
header "ИТОГОВЫЙ ОТЧЕТ"

echo ""
echo -e "  ${GREEN}Успешных проверок:    $PASS${NC}"
echo -e "  ${RED}Проваленных проверок: $FAIL${NC}"
echo -e "  ${YELLOW}Предупреждений:       $WARN${NC}"
echo ""

TOTAL=$((PASS + FAIL + WARN))
if [ "$TOTAL" -gt 0 ]; then
    PERCENT=$((PASS * 100 / TOTAL))
    echo -e "  Общий процент успеха: ${PERCENT}%"
fi

echo ""
if [ "$FAIL" -eq 0 ]; then
    echo -e "  ${GREEN}✓ Все критичные проверки пройдены успешно!${NC}"
    exit 0
else
    echo -e "  ${RED}✗ Обнаружены проблемы. Проверьте вывод выше.${NC}"
    exit 1
fi
